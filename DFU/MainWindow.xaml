<Window x:Class="DfuTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jhoinrch CAN Tool"
        Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app-icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="#EEF1F4"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- ========== Palette: silver-white high-tech ========== -->
        <SolidColorBrush x:Key="BgBrush" Color="#EEF1F4"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F9FB"/>
        <SolidColorBrush x:Key="InkBrush" Color="#111820"/>
        <SolidColorBrush x:Key="InkMutedBrush" Color="#5C6675"/>
        <SolidColorBrush x:Key="InkFaintBrush" Color="#8A93A1"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D5DBE3"/>
        <SolidColorBrush x:Key="LineStrongBrush" Color="#B8C1CD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0B7A9A"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#D7EEF5"/>
        <SolidColorBrush x:Key="OkBrush" Color="#0F7A4A"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="PrimaryBtnBrush" Color="#1A2330"/>
        <SolidColorBrush x:Key="PrimaryBtnHoverBrush" Color="#243044"/>
        <SolidColorBrush x:Key="PrimaryBtnPressBrush" Color="#0E141C"/>
        <SolidColorBrush x:Key="LogBgBrush" Color="#12161C"/>
        <SolidColorBrush x:Key="LogInkBrush" Color="#C8D0DC"/>

        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F6F8" Offset="0"/>
            <GradientStop Color="#E8ECF1" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C6675"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Card panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F6F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8E99A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E4E9EF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F0F2F5"/>
                                <Setter Property="Foreground" Value="#A0A8B4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource PrimaryBtnBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="#F2F5F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBtnHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBtnPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C5CCD6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C5CCD6"/>
                                <Setter Property="Foreground" Value="#F5F7FA"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#EFF2F5"/>
                                <Setter Property="Foreground" Value="#97A0AD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="DeviceCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#5C6675"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8E99A8"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Margin="10,0,28,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#EFF2F5"/>
                                <Setter Property="Foreground" Value="#97A0AD"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label text -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Status pill -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowGradient}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
        <DockPanel Margin="18,16,18,16">

            <!-- ===== Title bar strip ===== -->
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,14"
                    Padding="0,0,0,10"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Accent tick -->
                    <Border Width="4" Height="36" CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Jhoinrch CAN Tool"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <!-- Highlighted link buttons -->
                        <Button x:Name="GetFirmwareBtn"
                                Content="Get Firmware"
                                Height="28"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                Cursor="Hand"
                                BorderThickness="1"
                                Background="#C2410C"
                                BorderBrush="#C2410C"
                                Foreground="#FFFFFF"
                                ToolTip="Get firmware builds — https://canable.io/builds/"
                                Click="GetFirmwareBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#A3340A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#A3340A"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#8A2C08"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#D4A08A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#D4A08A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="MoreProductsBtn"
                                Content="More Products"
                                Height="28"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                Cursor="Hand"
                                BorderThickness="1"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="#FFFFFF"
                                ToolTip="More products on Amazon"
                                Click="MoreProductsBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#096A87"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#096A87"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#075A74"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#9AB8C4"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#9AB8C4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SiteLinkBtn"
                                Content="Jhoinrch.net"
                                Height="28"
                                Padding="12,0"
                                Margin="0,0,10,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                Cursor="Hand"
                                BorderThickness="1"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="#FFFFFF"
                                ToolTip="https://Jhoinrch.net"
                                Click="SiteLinkBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#096A87"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#096A87"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#075A74"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#9AB8C4"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#9AB8C4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border VerticalAlignment="Center"
                                Padding="10,5"
                                CornerRadius="999"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#A8D5E4"
                                BorderThickness="1">
                            <TextBlock Text="DFU MODE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Device card ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="01  DEVICE" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceCombo"
                                  Style="{StaticResource DeviceCombo}"
                                  HorizontalContentAlignment="Left"/>
                        <Button x:Name="ZadigBtn"
                                Grid.Column="1"
                                Style="{StaticResource GhostBtn}"
                                Content="ZADIG"
                                Width="86"
                                Margin="8,0,0,0"
                                ToolTip="Open Zadig to bind WinUSB driver"
                                Click="ZadigBtn_Click"/>
                        <Button x:Name="RefreshBtn"
                                Grid.Column="2"
                                Style="{StaticResource GhostBtn}"
                                Content="REFRESH"
                                Width="110"
                                Margin="8,0,0,0"
                                Click="RefreshBtn_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Compatibility notice (prominent) ===== -->
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,12"
                    Padding="14,12"
                    CornerRadius="6"
                    Background="#FFF7ED"
                    BorderBrush="#EA580C"
                    BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4"
                            CornerRadius="2"
                            Background="#EA580C"
                            VerticalAlignment="Stretch"
                            Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="FIRMWARE COMPATIBILITY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#9A3412"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#7C2D12"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            RH02 works with Canable 1.0<LineBreak/>
                            RH02 Plus/PRO works with Canable 2.0<LineBreak/>
                            <Run FontWeight="Bold" Foreground="#C2410C">Please flash the matching firmware version, or the device will not work correctly.</Run>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Firmware card ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="02  FIRMWARE" Style="{StaticResource SectionLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" Style="{StaticResource FieldBox}"/>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="BROWSE" Width="88" Margin="8,0,0,0" Click="BrowseBtn_Click"/>
                        <Button x:Name="ParseBtn" Grid.Column="2" Style="{StaticResource GhostBtn}"
                                Content="PARSE" Width="76" Margin="8,0,0,0" Click="ParseBtn_Click"/>
                    </Grid>

                    <TextBlock x:Name="FileInfoText"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5"
                               LineHeight="18"
                               Foreground="{StaticResource InkMutedBrush}"/>

                    <Separator Margin="0,12,0,10"
                               Background="{StaticResource LineBrush}"
                               BorderThickness="0"
                               Height="1"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource FieldBox}"
                                 Margin="8,0,0,0" Text="0x08000000" IsEnabled="False"/>
                        <TextBlock Grid.Column="3" Text="Read length (bytes)"
                                   Style="{StaticResource FieldLabel}" Margin="16,0,0,0"/>
                        <TextBox x:Name="LengthBox" Grid.Column="4" Style="{StaticResource FieldBox}"
                                 Margin="8,0,0,0" Text="65536"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Actions ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FlashBtn"
                                Style="{StaticResource PrimaryBtn}"
                                Content="DOWNLOAD"
                                Width="140"
                                Click="FlashBtn_Click"/>
                        <Button x:Name="ReadBtn"
                                Grid.Column="1"
                                Style="{StaticResource GhostBtn}"
                                Content="READ"
                                Width="110"
                                Margin="8,0,0,0"
                                Click="ReadBtn_Click"/>
                        <Button x:Name="CancelBtn"
                                Grid.Column="2"
                                Style="{StaticResource GhostBtn}"
                                Content="CANCEL"
                                Width="96"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                Click="CancelBtn_Click"/>

                        <Border Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="10,6"
                                CornerRadius="999"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                         Fill="{StaticResource OkBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText"
                                           Style="{StaticResource StatusText}"
                                           Text="Ready"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Flash / read progress -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROGRESS"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <ProgressBar x:Name="ProgressFill"
                                     Grid.Column="1"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     BorderThickness="0"
                                     Background="#E4E9EF"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center"
                                     ToolTip="Firmware transfer progress from dfu-util"/>
                        <TextBlock x:Name="ProgressPercent"
                                   Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Text="0%"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Log (fills remaining space) ===== -->
            <Border Style="{StaticResource Card}"
                    Padding="0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10"
                            CornerRadius="6,6,0,0">
                        <TextBlock Text="03  LOG · DFU-UTIL OUTPUT"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0"/>
                    </Border>
                    <Border Background="{StaticResource LogBgBrush}"
                            BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,5,5">
                        <TextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11.5"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource LogInkBrush}"
                                 Padding="12,10"/>
                    </Border>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
